# gpt_load configuration -- copy to .env and edit. Never commit .env.
# Everything here is read from the process environment (twelve-factor).

# --- identity ---------------------------------------------------------------
APP_ENV=development
# Required when APP_ENV=production; the app refuses to start without it.
SECRET_KEY=change-me-in-production

# --- HTTP -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
MAX_CONTENT_LENGTH=8388608

# --- storage ----------------------------------------------------------------
# Leave empty to use the bundled sqlite database under var/instance.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/gpt_load
DATA_DIR=
INSTANCE_DIR=
LOG_DIR=

# --- observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
REQUEST_ID_HEADER=X-Request-ID

# --- application-specific ---------------------------------------------------
# Variables the application modules read directly. Settings.extras reports
# whichever of LEGACY_ENV_VARS are set; PORT and SECRET_KEY are already
# documented above and are listed here only because the application reads
# them itself.
ANALYTICS_SALT=change-me-in-production
